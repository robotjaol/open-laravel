{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "open-laravel",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint resources/js",
        "format": "prettier --write resources/js resources/css",
        "format:check": "prettier --check resources/js resources/css",
        "types:check": "tsc --noEmit",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "check": "npm run lint && npm run format:check && npm run types:check && npm run test",
        "build:preview": "vite build --config vite.preview.config.ts && mv docs/preview/preview.html docs/preview/index.html",
        "preview:screenshots": "node scripts/screenshots.mjs"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@inertiajs/react": "^3.11.0",
        "@radix-ui/react-avatar": "^1.3.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-separator": "^1.2.0",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-tooltip": "^1.4.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.74.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@inertiajs/vite": "^3.11.0",
        "@playwright/test": "^1.65.1",
        "@tailwindcss/vite": "^4.3.5",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.12",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "@vitest/coverage-v8": "^5.1.0",
        "concurrently": "^10.0.7",
        "eslint": "^10.15.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.14.0",
        "jsdom": "^31.0.1",
        "laravel-vite-plugin": "^3.2.1",
        "prettier": "^3.10.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.5",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.73.0",
        "vite": "^8.3.8",
        "vitest": "^5.1.0"
    }
}
