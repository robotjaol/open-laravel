APP_NAME="Open Laravel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# SQLite works out of the box. Switch to pgsql/mysql for real deployments (see docker-compose.yml).
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=open_laravel
# DB_USERNAME=postgres
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Application behaviour -------------------------------------------------
REGISTRATION_ENABLED=false
REQUIRE_EMAIL_VERIFICATION=false
AUDIT_RETENTION_DAYS=365
SANCTUM_TOKEN_EXPIRATION=480
# Comma separated module folder names to disable, e.g. Projects
DISABLED_MODULES=

# Local development seed only. Never use these values outside a developer machine.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe-Local-Only-123!

VITE_APP_NAME="${APP_NAME}"
